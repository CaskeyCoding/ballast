# Copy to .env and fill in. .env is gitignored. Keep NO secrets here.

# The Anthropic key is read from AWS Secrets Manager at runtime (matches the fleet; no key on disk).
ANTHROPIC_SECRET_ID=ai-blog/anthropic-api-key
# AWS_REGION is optional; boto3 uses your default profile/region if unset.
# AWS_REGION=us-east-1

# Dev-only override: set this ONLY on a machine with no AWS access. Leave blank otherwise so the
# key comes from Secrets Manager. Unit tests use FakeLLMClient and need neither.
# ANTHROPIC_API_KEY=

# Where the Chroma vector store persists (default: .chroma).
CHROMA_DIR=.chroma

# Per-run hard cost cap in USD; a run that would exceed it raises before overspending.
RUN_BUDGET_USD=1.0
